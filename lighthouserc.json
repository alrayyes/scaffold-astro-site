{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-report"
    },
    "assert": {
      "assertions": {
        "cache-insight": "off",
        "document-latency-insight": "off",
        "render-blocking-insight": "warn",
        "network-dependency-tree-insight": "warn",
        "unused-javascript": "warn"
      }
    }
  }
}
