{
  "name": "scaffold-astro-site",
  "version": "1.0.0",
  "private": true,
  "description": "A GitHub template for an Astro site, deployed to Cloudflare.",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "astro check",
    "deploy": "wrangler deploy",
    "deploy:version": "wrangler versions upload",
    "dev": "astro dev",
    "format": "biome check --write .",
    "format:check": "prettier --check \"**/*.{md,yml,yaml,astro}\"",
    "lint": "biome check .",
    "lint:md": "markdownlint-cli2",
    "lint:mechanics": "./scripts/lint-mechanics.sh",
    "lint:prose": "./scripts/lint-prose.sh",
    "prepare": "lefthook install || true",
    "preview": "wrangler dev --port 4321",
    "sort-package-json": "sort-package-json",
    "sort-package-json:check": "sort-package-json --check",
    "test": "bun run test:unit && bun run test:e2e",
    "test:e2e": "playwright test",
    "test:unit": "bun test src --coverage --coverage-reporter=lcov --reporter=junit --reporter-outfile=coverage/junit-unit.xml"
  },
  "overrides": {
    "sharp": "0.35.4",
    "smol-toml": "1.7.1"
  },
  "dependencies": {
    "@codecov/astro-plugin": "2.0.1",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.1",
    "lefthook": "2.1.12",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sort-package-json": "4.0.0",
    "typescript": "6.0.3",
    "wrangler": "4.129.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "esbuild",
    "lefthook",
    "workerd"
  ]
}
