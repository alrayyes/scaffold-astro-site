# Cloudflare Workers static assets read this file from the build output.
# Astro fingerprints everything under /_astro/, so it can be cached for a year
# and never revalidated. Pages keep Cloudflare's default
# (public, max-age=0, must-revalidate), which is right for HTML.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
